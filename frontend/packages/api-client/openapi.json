{
    "openapi": "3.1.0",
    "info": {
        "title": "OpenAPI definition",
        "version": "v0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Generated server url"
        }
    ],
    "paths": {
        "/api/v1/store/products/{slug}": {
            "get": {
                "tags": [
                    "store-product-controller"
                ],
                "operationId": "getProduct",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductDetailResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/store/categories": {
            "get": {
                "tags": [
                    "store-category-controller"
                ],
                "operationId": "list",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/store/categories/{slug}/products": {
            "get": {
                "tags": [
                    "store-product-controller"
                ],
                "operationId": "listProducts",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "colour",
                        "in": "query",
                        "description": "Comma-separated colour family codes",
                        "required": false,
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "example": "red,maroon"
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "description": "Comma-separated sizes",
                        "required": false,
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "example": "M,L"
                    },
                    {
                        "name": "inStock",
                        "in": "query",
                        "description": "Only products with stock in the selected colour/size",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    {
                        "name": "priceMin",
                        "in": "query",
                        "description": "Minimum price in paise",
                        "required": false,
                        "schema": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "format": "int32"
                        }
                    },
                    {
                        "name": "priceMax",
                        "in": "query",
                        "description": "Maximum price in paise",
                        "required": false,
                        "schema": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "format": "int32"
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "popular",
                            "enum": [
                                "popular",
                                "new",
                                "price_asc",
                                "price_desc",
                                "discount"
                            ]
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "1-based page number",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Products per page, at most 48",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 24
                        }
                    },
                    {
                        "name": "fabric",
                        "in": "query",
                        "description": "Comma-separated facet value codes (OR within the facet)",
                        "example": "silk,cotton"
                    },
                    {
                        "name": "occasion",
                        "in": "query",
                        "description": "Comma-separated facet value codes (OR within the facet)",
                        "example": "wedding"
                    },
                    {
                        "name": "weave",
                        "in": "query",
                        "description": "Comma-separated facet value codes (OR within the facet)",
                        "example": "banarasi"
                    },
                    {
                        "name": "work",
                        "in": "query",
                        "description": "Comma-separated facet value codes (OR within the facet)",
                        "example": "zari"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductListingResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
