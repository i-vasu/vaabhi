# Copy to /opt/vaabhi/.env on the VPS (chmod 600). Never commit real values.
# Neon project "vaabhi" (wispy-hill-84243000, AWS ap-southeast-1). Copy both URLs from the Neon
# console (Connect) or from `neon init`'s .env.local. postgres:// URLs are converted to JDBC by the
# backend; the pooled URL serves the app, the unpooled (direct) URL runs Flyway migrations.
DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<password>@<endpoint>.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://vaabhi.com,https://admin.vaabhi.com

# Grafana Cloud (Home → Connections → OpenTelemetry)
OTEL_EXPORT_ENABLED=true
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# "Basic <base64(instanceId:token)>"
GRAFANA_OTLP_AUTH=
# Same credentials in OTEL header format for the storefront: Authorization=Basic%20<base64>
GRAFANA_OTLP_HEADERS=
TRACING_SAMPLING=0.1

CF_TUNNEL_TOKEN=

# Product photos in Cloudflare R2 (see vps-setup.md → Product photos). Uploads are refused while unset.
R2_ACCOUNT_ID=9866817007578d38cd27b8bf64773774
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_BUCKET=vaabhi-media
# MEDIA_URL=https://media.vaabhi.com
