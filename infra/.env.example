# Copy to /opt/vaabhi/.env on the VPS (chmod 600). Never commit real values.
# Neon project "vaabhi" (wispy-hill-84243000, AWS ap-southeast-1). Copy both URLs from the Neon
# console (Connect) or from `neon init`'s .env.local. postgres:// URLs are converted to JDBC by the
# backend; the pooled URL serves the app, the unpooled (direct) URL runs Flyway migrations.
DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<password>@<endpoint>.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://vaabhi.com,https://admin.vaabhi.com

# First admin dashboard owner, created on the first start while no staff account exists (see vps-setup.md →
# Admin access). Use a long password; after the first sign-in the password line can be removed.
STAFF_OWNER_NAME=
STAFF_OWNER_EMAIL=
STAFF_OWNER_PASSWORD=

# Grafana Cloud (Home → Connections → OpenTelemetry)
OTEL_EXPORT_ENABLED=true
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# "Basic <base64(instanceId:token)>"
GRAFANA_OTLP_AUTH=
# Same credentials in OTEL header format for the storefront: Authorization=Basic%20<base64>
GRAFANA_OTLP_HEADERS=
TRACING_SAMPLING=0.1

CF_TUNNEL_TOKEN=

# Customer sign-in (docs/AUTH.md). Usually kept as GitHub production secrets; every deploy writes them here.
# Google: OAuth web client id (used by backend and storefront).
GOOGLE_CLIENT_ID=
# Phone OTP via MSG91: auth key and the DLT-approved OTP template id (variable ##otp##).
# Until both are set, phone sign-in answers "not available" and Google still works.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Order emails to customers over SMTP (any service: MSG91 Email, Google Workspace, ZeptoMail, SES). Usually kept as
# GitHub production secrets. Without MAIL_HOST no email is sent. Port 587 uses STARTTLS, 465 SSL.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM=Vaabhi <orders@mail.vaabhi.com>
# MAIL_REPLY_TO=support@vaabhi.com
# STOREFRONT_URL=https://vaabhi.com

# Product photos in Cloudflare R2 (see vps-setup.md → Product photos). Uploads are refused while unset.
R2_ACCOUNT_ID=9866817007578d38cd27b8bf64773774
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_BUCKET=vaabhi-media
# MEDIA_URL=https://media.vaabhi.com

# WhatsApp through MSG91 (no DLT). Uses MSG91_AUTH_KEY; number and template names have defaults in application.yml.
# WHATSAPP_NUMBER=917569189366
# WHATSAPP_LOGIN_TEMPLATE=        (Authentication template; turns on phone sign-in by WhatsApp)
# WHATSAPP_ORDER_SHIPPED_TEMPLATE=
# WHATSAPP_ORDER_CANCELLED_TEMPLATE=
# WHATSAPP_NAMESPACE=              (only if MSG91 shows one for your templates)
